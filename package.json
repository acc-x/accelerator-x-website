{
  "name": "accelerator-x-website",
  "version": "1.0.0",
  "description": "This repo contains the public landing page for Accelerator X.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npx serve .",
    "build:css": "tailwindcss -i ./scripts/tailwind.input.css -o ./assets/css/tailwind.generated.css --minify",
    "build:css-bundle": "node scripts/build-css-bundle.js",
    "build:homepage": "node scripts/build-homepage.js",
    "build:hero-media": "node scripts/build-hero-media.js",
    "build:design-system": "node scripts/build-design-system.js",
    "process:hero-images": "bash scripts/process-hero-images.sh",
    "build:inner-pages": "node scripts/build-inner-pages.js",
    "build": "npm run build:homepage && node scripts/build-testimonials.js && npm run build:hero-media && npm run build:design-system && npm run build:inner-pages && node scripts/build-hub.js && npm run build:css && npm run build:css-bundle",
    "prepare": "git config core.hooksPath .githooks",
    "check": "node scripts/check.js",
    "test": "node --test tests/functions/lead-capture.test.js tests/functions/newsletter-subscribe.test.js tests/functions/cohort-application.test.js tests/build/hub-utils.test.js tests/build/built-site.test.js tests/build/marker-injection.test.js tests/build/atomic-write.test.js && npm run test:session-protocols",
    "test:session-protocols": "node scripts/test-session-protocols.js",
    "skills:sync": "node scripts/skills-sync.js",
    "skills:sync:force": "node scripts/skills-sync.js --force",
    "session-start": "node scripts/session-start.js",
    "session-start:json": "node scripts/session-start.js --json",
    "session-end": "node scripts/session-end.js",
    "session-end:dry-run": "node scripts/session-end.js --dry-run",
    "session-end:write": "node scripts/session-end.js --confirm-write",
    "session-end:write:yes": "node scripts/session-end.js --confirm-write --yes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acc-x/accelerator-x-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/acc-x/accelerator-x-website/issues"
  },
  "homepage": "https://github.com/acc-x/accelerator-x-website#readme",
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^17.0.3"
  }
}
